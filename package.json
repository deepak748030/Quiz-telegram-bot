{
  "name": "telegram-gemini-quiz-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Fast Telegram quiz bot for text and PDFs, powered by Gemini and deployable on Vercel Hobby.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npx --yes vercel@59.1.3 dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "webhook:set": "node scripts/telegram-webhook.mjs set",
    "webhook:info": "node scripts/telegram-webhook.mjs info",
    "webhook:delete": "node scripts/telegram-webhook.mjs delete"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@vercel/functions": "^3.9.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
