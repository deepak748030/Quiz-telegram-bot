{
  "name": "telegram-gemini-quiz-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Fast Telegram quiz bot for text and PDFs, powered by Gemini. Runs as a long-lived web service on Render (webhook based).",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "webhook:set": "node scripts/telegram-webhook.mjs set",
    "webhook:info": "node scripts/telegram-webhook.mjs info",
    "webhook:delete": "node scripts/telegram-webhook.mjs delete"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@vercel/functions": "^3.9.3",
    "dotenv": "^17.4.2",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.19.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
