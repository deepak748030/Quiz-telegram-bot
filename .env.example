# Required — obtain from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token

# Required — random A-Z/a-z/0-9/_/- string, 1-256 chars
# Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Required — create at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Latest stable Gemini model with a free API tier as of 2026-08-16
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional tuning
DEFAULT_QUIZ_COUNT=8
MAX_QUIZ_COUNT=15
MAX_PDF_BYTES=20000000
POLL_DELAY_MS=1000

# Used only by npm run webhook:set; can also pass the URL as an argument
WEBHOOK_URL=https://your-project.vercel.app/api/webhook
